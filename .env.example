# Pick ONE. Both Groq and Gemini are free and need no credit card.

# Groq -- console.groq.com/keys   (recommended: fastest, good for a live demo)
GROQ_API_KEY=

# Google Gemini -- aistudio.google.com/apikey
# GEMINI_API_KEY=

# Any OpenAI-compatible endpoint: OpenRouter free models, local Ollama, LM Studio
# OPENAI_API_KEY=
# PRAMAAN_OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Paid, optional
# ANTHROPIC_API_KEY=

# With no key at all PRAMAAN still runs: retrieval, citations and the gate are
# all local. The drafting step falls back to extractive (verbatim clause
# sentences). Good for offline, but it does not exercise the gate.
# PRAMAAN_DRAFT_PROVIDER=extractive

# Optional overrides (defaults in pramaan/config.py)
# PRAMAAN_ENTAILMENT_THRESHOLD=0.5
# PRAMAAN_VERIFIER_BACKEND=auto
# PRAMAAN_TOP_K=10
